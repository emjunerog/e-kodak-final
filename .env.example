# ══════════════════════════════════════════════════════
#  E-Kodak Photography — Environment Variables (EXAMPLE)
# ══════════════════════════════════════════════════════
#
# SETUP INSTRUCTIONS:
#  1. Copy this file to .env (never commit .env to Git)
#  2. Go to your Supabase project → Settings → API
#  3. Paste your Project URL and anon public key below
#  4. Restart the dev server: npm run dev
#
# IMPORTANT:
#  - .env is already listed in .gitignore — make sure it stays ignored
#  - Only VITE_ prefixed variables are exposed to the browser
#  - NEVER put your service_role key here
#  - Treat VITE_GEMINI_API_KEY as PUBLIC — it ships to every visitor.
#    The Gemini key below is only for local development. For production,
#    route AI requests through a backend proxy and store the key server-side.
# ══════════════════════════════════════════════════════

# ── Supabase ─────────────────────────────────────────
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── AI Assistant (Gemini API) ────────────────────────
# Local dev only — see note above about production proxying.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ── Direct Postgres Database URL (Optional) ─────────
# Used exclusively by migration/maintenance scripts in /scripts
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

