{
  "expo": {
    "name": "E-Kodak Studio",
    "slug": "ekodak-companion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ekodak-logo.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ekodak.companion"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/ekodak-logo.png",
        "backgroundColor": "#EEF1F6"
      },
      "package": "com.ekodak.companion",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "E-Kodak needs camera access to scan your booking QR code."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C9A96E"
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/ekodak-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#EEF1F6"
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-audio",
      "expo-asset"
    ]
  }
}
